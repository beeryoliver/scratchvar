% Define functions

\cs_new_protected:Npn \scratchvar_generate:n #1
  { \exp_args:No \__scratchvar_generate:n { \tl_to_str:n {#1} } }
\cs_new_protected:Npn \__scratchvar_generate:n #1
  {
    \tl_map_inline:nn
      {
        { l__#1_tmpa_regex }
        { l__#1_tmpb_regex }
        { g__#1_tmpa_regex }
        { g__#1_tmpb_regex }
      }
      { \cs_if_exist:cF {##1} { \exp_args:Nc \regex_new:N {##1} } }
    \tl_map_inline:nn
      {
        {bool}
        {tl}
        {str}
        {seq}
        {int}
        {clist}
        {prop}
        {dim}
        {skip}
        {muskip}
        {fp}
        {box}
        {coffin}
      }
      {
        \use:c { ##1_if_exist:cF } { l__#1_tmpa_##1 }
          { \use:c { ##1_new:c } { l__#1_tmpa_##1 } }
        \use:c { ##1_if_exist:cF } { l__#1_tmpb_##1 }
          { \use:c { ##1_new:c } { l__#1_tmpb_##1 } }
        \use:c { ##1_if_exist:cF } { g__#1_tmpa_##1 }
          { \use:c { ##1_new:c } { g__#1_tmpa_##1 } }
        \use:c { ##1_if_exist:cF } { g__#1_tmpb_##1 }
          { \use:c { ##1_new:c } { g__#1_tmpb_##1 } }
      }
    \cs_if_exist:cF { g__#1_tmpa_ior } { \ior_new:c { g__#1_tmpa_ior } }
    \cs_if_exist:cF { g__#1_tmpb_ior } { \ior_new:c { g__#1_tmpb_ior } }
    \cs_if_exist:cF { g__#1_tmpa_iow } { \iow_new:c { g__#1_tmpa_iow } }
    \cs_if_exist:cF { g__#1_tmpb_iow } { \iow_new:c { g__#1_tmpb_iow } }
    \cctab_if_exist:cF { g__#1_tmpa_cctab }
      { \cctab_new:c { g__#1_tmpa_cctab } }
    \cctab_if_exist:cF { g__#1_tmpb_cctab }
      { \cctab_new:c { g__#1_tmpb_cctab } }
    \flag_if_exist:cF { l__#1_tmpa_flag } { \flag_new:c { l__#1_tmpa_flag } }
    \flag_if_exist:cF { l__#1_tmpb_flag } { \flag_new:c { l__#1_tmpb_flag } }
  }
